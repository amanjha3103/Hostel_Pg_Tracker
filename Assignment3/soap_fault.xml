
<?xml version="1.0" encoding="UTF-8"?>
<soap:Envelope
    xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
    xmlns:pay="http://example.com/payment">

    <soap:Body>
        <soap:Fault>
            <faultcode>soap:Client</faultcode>
            <faultstring>Payment declined by the bank</faultstring>
            <detail>
                <pay:PaymentError>
                    <pay:errorCode>PAYMENT_DECLINED</pay:errorCode>
                    <pay:paymentId>PAY901</pay:paymentId>
                    <pay:message>
                        The bank did not authorize this transaction.
                    </pay:message>
                </pay:PaymentError>
            </detail>
        </soap:Fault>
    </soap:Body>

</soap:Envelope>
